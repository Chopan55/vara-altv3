# ─── OpenAI ───
# platform.openai.com → API keys
# OJO: es facturación separada de ChatGPT. Tener ChatGPT Plus NO da crédito de API.
# Cargar saldo en platform.openai.com → Settings → Billing.
OPENAI_API_KEY=sk-proj-...

# ─── Supabase ───
# supabase.com → tu proyecto → Settings → API
# Estas dos son públicas por diseño: lo que protege los datos es RLS, no la key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# La service_role key NUNCA va acá ni se comparte por chat: saltea RLS por completo.
# Si alguna vez hace falta, va solo en las env vars de Vercel.
# SUPABASE_SERVICE_ROLE_KEY=
